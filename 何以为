local Config = {
    MaxDepth = 8,
    OutputFormat = "json",
    FileName = "Roblox_Game_Analysis.json",
    IncludeAttributes = true,
    IncludeValues = true,
    IncludeRemotes = true,
    IncludeScripts = true,
    IncludeProperties = true,
    MaxObjects = 50000
}

local Results = {}
local ObjectCount = 0
local Scanning = false
local StopScan = false

local function safeCall(fn, default)
    local ok, result = pcall(fn)
    if ok then
        return result
    end
    return default
end

local function getFullName(obj)
    return safeCall(function()
        return obj:GetFullName()
    end, obj.Name)
end

local function serializeValue(value)
    local t = typeof(value)

    if t == "Vector2" then
        return {
            Type = t,
            X = value.X,
            Y = value.Y
        }
    elseif t == "Vector3" then
        return {
            Type = t,
            X = value.X,
            Y = value.Y,
            Z = value.Z
        }
    elseif t == "Color3" then
        return {
            Type = t,
            R = value.R,
            G = value.G,
            B = value.B
        }
    elseif t == "CFrame" then
        local components = {value:GetComponents()}
        return {
            Type = t,
            Components = components
        }
    elseif t == "UDim" then
        return {
            Type = t,
            Scale = value.Scale,
            Offset = value.Offset
        }
    elseif t == "UDim2" then
        return {
            Type = t,
            XScale = value.X.Scale,
            XOffset = value.X.Offset,
            YScale = value.Y.Scale,
            YOffset = value.Y.Offset
        }
    elseif t == "BrickColor" then
        return {
            Type = t,
            Number = value.Number,
            Name = value.Name
        }
    elseif t == "EnumItem" then
        return {
            Type = t,
            Name = value.Name,
            EnumType = tostring(value.EnumType)
        }
    elseif t == "Instance" then
        return {
            Type = t,
            Path = safeCall(function()
                return value:GetFullName()
            end, tostring(value))
        }
    elseif t == "table" then
        return value
    elseif t == "string" or t == "number" or t == "boolean" then
        return value
    end

    return tostring(value)
end

local function getAttributes(obj)
    if not Config.IncludeAttributes then
        return nil
    end

    local attributes = {}

    local ok, data = pcall(function()
        return obj:GetAttributes()
    end)

    if not ok then
        return attributes
    end

    for name, value in pairs(data) do
        attributes[name] = serializeValue(value)
    end

    return attributes
end

local function getValue(obj)
    if not Config.IncludeValues then
        return nil
    end

    local supported = {
        StringValue = true,
        IntValue = true,
        NumberValue = true,
        BoolValue = true,
        ObjectValue = true,
        Vector3Value = true,
        Vector2Value = true,
        CFrameValue = true,
        Color3Value = true,
        BrickColorValue = true,
        RayValue = true
    }

    if not supported[obj.ClassName] then
        return nil
    end

    local ok, value = pcall(function()
        return obj.Value
    end)

    if not ok then
        return nil
    end

    return serializeValue(value)
end

local function getBasicProperties(obj)
    if not Config.IncludeProperties then
        return nil
    end

    local data = {}

    local properties = {
        "Archivable",
        "Enabled",
        "Visible",
        "Active",
        "Anchored",
        "CanCollide",
        "CanTouch",
        "CanQuery",
        "Transparency",
        "Reflectance",
        "Massless",
        "CastShadow",
        "Material",
        "Size",
        "Position",
        "Orientation",
        "AssemblyLinearVelocity",
        "AssemblyAngularVelocity",
        "WalkSpeed",
        "JumpPower",
        "Health",
        "MaxHealth",
        "DisplayName",
        "Text",
        "TextSize",
        "TextColor3",
        "BackgroundColor3",
        "BackgroundTransparency",
        "Image",
        "ImageTransparency"
    }

    for _, property in ipairs(properties) do
        local ok, value = pcall(function()
            return obj[property]
        end)

        if ok then
            local serialized = serializeValue(value)

            if serialized ~= nil then
                data[property] = serialized
            end
        end
    end

    return data
end

local function scanObject(obj, depth, parent)
    if StopScan then
        return
    end

    if ObjectCount >= Config.MaxObjects then
        return
    end

    ObjectCount += 1

    local entry = {
        Name = safeCall(function()
            return obj.Name
        end, "?"),

        ClassName = safeCall(function()
            return obj.ClassName
        end, "?"),

        FullName = getFullName(obj),

        Depth = depth
    }

    if Config.IncludeAttributes then
        entry.Attributes = getAttributes(obj)
    end

    if Config.IncludeValues then
        local value = getValue(obj)

        if value ~= nil then
            entry.Value = value
        end
    end

    if Config.IncludeProperties then
        entry.Properties = getBasicProperties(obj)
    end

    if Config.IncludeRemotes then
        if obj:IsA("RemoteEvent") then
            entry.RemoteType = "RemoteEvent"
        elseif obj:IsA("RemoteFunction") then
            entry.RemoteType = "RemoteFunction"
        elseif obj:IsA("UnreliableRemoteEvent") then
            entry.RemoteType = "UnreliableRemoteEvent"
        end
    end

    if Config.IncludeScripts then
        if obj:IsA("Script") then
            entry.ScriptType = "Script"
        elseif obj:IsA("LocalScript") then
            entry.ScriptType = "LocalScript"
        elseif obj:IsA("ModuleScript") then
            entry.ScriptType = "ModuleScript"
        end
    end

    table.insert(Results, entry)

    if depth >= Config.MaxDepth then
        return
    end

    local children = safeCall(function()
        return obj:GetChildren()
    end, {})

    for _, child in ipairs(children) do
        if StopScan then
            break
        end

        scanObject(child, depth + 1, obj)

        if ObjectCount % 100 == 0 then
            task.wait()
        end
    end
end

local function generateOutput()
    local data = {
        Metadata = {
            GeneratedAt = os.date("%Y-%m-%d %H:%M:%S"),
            Player = LocalPlayer and LocalPlayer.Name or "Unknown",
            UserId = LocalPlayer and LocalPlayer.UserId or 0,
            MaxDepth = Config.MaxDepth,
            ObjectCount = ObjectCount
        },

        Configuration = Config,

        Objects = Results
    }

    return data
end

local function saveFile()
    if typeof(writefile) ~= "function" then
        return false, "当前执行环境没有 writefile"
    end

    local data = generateOutput()

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not ok then
        return false, "JSON 编码失败"
    end

    local success, err = pcall(function()
        writefile(Config.FileName, encoded)
    end)

    if not success then
        return false, tostring(err)
    end

    return true, Config.FileName
end

local function clearResults()
    table.clear(Results)
    ObjectCount = 0
    StopScan = false
end

local function startScan(root)
    if Scanning then
        return
    end

    Scanning = true
    StopScan = false

    clearResults()

    task.spawn(function()
        scanObject(root, 0, nil)

        Scanning = false

        if not StopScan then
            local success, result = saveFile()

            if success then
                print("[GameAnalyzer] 导出完成:", result)
                print("[GameAnalyzer] 对象数量:", ObjectCount)
            else
                warn("[GameAnalyzer] 导出失败:", result)
            end
        else
            print("[GameAnalyzer] 扫描已停止")
        end
    end)
end

local function stopScan()
    StopScan = true
end

local function exportAgain()
    local success, result = saveFile()

    if success then
        print("[GameAnalyzer] 已重新导出:", result)
    else
        warn("[GameAnalyzer] 导出失败:", result)
    end
end

